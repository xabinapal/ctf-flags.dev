---
import "@fontsource/ibm-plex-mono/300.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/600.css";
import "../styles/site.css";
import Consent from "../components/Consent.astro";

interface Props {
  path: string;
  title?: string;
  description?: string;
}

const { path, title, description = "" } = Astro.props;
const siteTitle = "ctf-flags.dev";
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const canonical = new URL(path, Astro.site);
const socialImage = new URL("/caption.png", Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="robots" content="index,follow" />
    <meta name="viewport" content="width=device-width, height=device-height, initial-scale=1" />
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="xabito" />
    <meta name="keywords" content="ctf, writeups, challenges, infosec, cybersecurity" />
    <meta name="theme-color" content="#112c2f" />
    <meta name="apple-mobile-web-app-title" content={pageTitle} />
    <meta name="msapplication-TileColor" content="#112c2f" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:locale" content="en_US" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical.href} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImage.href} />
    <link rel="canonical" href={canonical.href} />

    <link rel="icon" type="image/png" href="/favicon-512.png" sizes="512x512" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icon-180.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

  </head>
  <body>
    <div class="glow-frame" aria-hidden="true"><div class="glow"></div></div>
    <header class="site-header">
      <div class="logo">
        <span class="pulse"></span>
        <a class="site-title" href="/">{siteTitle}</a>
      </div>
      <nav class="site-nav">
        <a href="/" class="nav-link">Writeups</a>
        <a href="/resources/" class="nav-link">Resources</a>
        <a href="/utilities/" class="nav-link">Utilities</a>
      </nav>
    </header>

    <main class="site-content"><slot /></main>

    <footer class="site-footer">
      <p>Built with love by @xabito.</p>
      <p>May your exploits land and your flags submit on the first try.</p>
    </footer>

    <Consent />
  </body>
</html>
