---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"button">, "type" | "aria-pressed"> {
  label: string;
  selected: boolean;
}

const { label, selected, class: className, ...attributes } = Astro.props;
---
<button {...attributes} type="button" class:list={["section-tab", className]} aria-pressed={selected ? "true" : "false"} data-label={label}><span>{label}</span></button>
