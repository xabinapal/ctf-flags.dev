---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"button">, "type" | "aria-pressed"> {
  selected: boolean;
}

const { selected, class: className, ...attributes } = Astro.props;
---
<button {...attributes} type="button" class:list={["section-tab", className]} aria-pressed={selected ? "true" : "false"}><slot /></button>
