---
import UtilityField from "./UtilityField.astro";
---
<UtilityField id="jwt-input" label="JWT Token" placeholder="Paste JWT token here..." rows={3} />
{["Header", "Payload", "Signature"].map((label) => (
  <div class="output-group">
    <span class="field-label">{label}</span>
    <pre id={`jwt-${label.toLowerCase()}`} class="code form-control"></pre>
  </div>
))}
