---
import UtilityField from "./UtilityField.astro";
---
<UtilityField id="xor-input-ascii" label="Input (UTF-8 text)" placeholder="Type input as UTF-8 text here..." rows={3} />
<UtilityField id="xor-input-hex" label="Input (HEX)" placeholder="Type input as HEX here..." rows={3} />
<UtilityField id="xor-key-ascii" label="Key (UTF-8 text)" placeholder="Type key as UTF-8 text here..." rows={2} />
<UtilityField id="xor-key-hex" label="Key (HEX)" placeholder="Type key as HEX here..." rows={2} />
<UtilityField id="xor-output-ascii" label="Output (UTF-8 text)" placeholder="Result will appear here..." rows={3} readonly />
<UtilityField id="xor-output-hex" label="Output (HEX)" placeholder="Result will appear here..." rows={3} readonly />
