---
import { plainText, renderSummary } from "../lib/markdown";

interface Card {
  title: string;
  href?: string | null;
  description?: string;
}

interface Props {
  title: string;
  cards: Card[];
}

const { title, cards } = Astro.props;
const entries = await Promise.all(cards.map(async (card) => ({
  ...card,
  description: plainText(await renderSummary(card.description)),
})));
---
{entries.length > 0 && (
  <section class="writeup-asset-group">
    <h2>{title}</h2>
    <ul class="list writeup-asset-list">
      {entries.map((entry) => {
        const Tag = entry.href ? "a" : "span";
        return (
          <li>
            <Tag class="writeup-asset-entry" href={entry.href ?? undefined} download={entry.href ? true : undefined}>
              {entry.href && <span class="writeup-asset-action" aria-hidden="true">&darr;</span>}
              <span class="writeup-asset-copy">
                <span class="writeup-asset-name">{entry.title}</span>
                {entry.description && <span>{entry.description}</span>}
              </span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </section>
)}
