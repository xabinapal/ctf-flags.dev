---
import { render } from "astro:content";
import CompetitionDates from "../../../components/CompetitionDates.astro";
import CompetitionResults from "../../../components/CompetitionResults.astro";
import Site from "../../../layouts/Site.astro";
import {
  type Competition,
  type Writeup,
  archivePath,
  attribution,
  groupWriteups,
  loadArchive,
} from "../../../lib/archives";
import { plainText, renderSummary, truncateWords } from "../../../lib/markdown";

export async function getStaticPaths() {
  const { competitions, writeupsByCompetition } = await loadArchive();
  return competitions.map((entry) => ({
    params: { competition: entry.id },
    props: { entry, writeups: writeupsByCompetition.get(entry.data.key) ?? [] },
  }));
}

interface Props {
  entry: Competition;
  writeups: Writeup[];
}

const { entry, writeups } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const overview = plainText(data.summary ?? "");
const groups = await Promise.all(groupWriteups(writeups).map(async ({ category, entries }) => ({
  category,
  cards: await Promise.all(entries.map(async (writeup) => ({
    writeup,
    summary: truncateWords(plainText(await renderSummary(writeup.data.summary))),
  }))),
})));
---
<Site path={archivePath(entry)} title={data.title} description={truncateWords(overview)}>
  <section class="hero">
    <h1>{data.title}</h1>
    {data.ctftime_url && (
      <div class="meta">
        <a href={data.ctftime_url} target="_blank" rel="noopener noreferrer">{data.ctftime_url}</a>
      </div>
    )}
    <div class="meta">
      <CompetitionDates start={data.start_date} end={data.end_date} />
    </div>
    <p class="summary">{overview}</p>
    <CompetitionResults ranking={data.ranking} points={data.points} />
  </section>

  {entry.body?.trim() && (
    <section class="section">
      <div class="content"><Content /></div>
    </section>
  )}

  {groups.length > 0 ? (
    <section class="section">
      <h2>Writeups from {data.title}</h2>
      {groups.map(({ category, cards }) => (
        <div class="category">
          <h3 class="category-title">{category}</h3>
          <ul class="list writeup-list">
            {cards.map(({ writeup, summary }) => (
              <li class="list-item">
                <a href={archivePath(writeup)} class="card-link">
                  <div class="card">
                    <h4 class="card-title">{writeup.data.title}</h4>
                    <div class="meta">
                      {attribution(writeup.data).map((item, index) => (
                        <>{index > 0 && <span>|</span>}<span>{item}</span></>
                      ))}
                    </div>
                    {summary && <p class="summary">{summary}</p>}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ) : (
    <section>
      <h2>No writeups yet</h2>
      <p class="empty-state">We haven't published any writeups for this competition yet. Check back soon.</p>
    </section>
  )}

  <div class="back-bar"><a class="back-link" href="/">&larr; Back to all competitions</a></div>
</Site>
