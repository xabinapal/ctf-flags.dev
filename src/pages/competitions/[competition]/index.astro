---
import ArchiveRow from "../../../components/ArchiveRow.astro";
import BackBar from "../../../components/BackBar.astro";
import ArchiveMasthead from "../../../components/ArchiveMasthead.astro";
import ExternalUrl from "../../../components/ExternalUrl.astro";
import BylineSeparator from "../../../components/BylineSeparator.astro";
import { render } from "astro:content";
import CompetitionDates from "../../../components/CompetitionDates.astro";
import CompetitionResults from "../../../components/CompetitionResults.astro";
import WriteupAttribution from "../../../components/WriteupAttribution.astro";
import Site from "../../../layouts/Site.astro";
import {
  type Competition,
  type Writeup,
  archivePath,
  attribution,
  groupWriteups,
  loadArchive,
} from "../../../lib/archives";
import { htmlExcerpt, renderSummary } from "../../../lib/markdown";

export async function getStaticPaths() {
  const { competitions, writeupsByCompetition } = await loadArchive();
  return competitions.map((entry) => ({
    params: { competition: entry.id },
    props: { entry, writeups: writeupsByCompetition.get(entry.data.key) ?? [] },
  }));
}

interface Props {
  entry: Competition;
  writeups: Writeup[];
}

const { entry, writeups } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const description = htmlExcerpt(entry.rendered?.html) || `Results and challenge writeups for ${data.title}.`;
const groups = await Promise.all(groupWriteups(writeups).map(async ({ category, entries }) => ({
  category,
  cards: await Promise.all(entries.map(async (writeup) => ({
    writeup,
    summary: htmlExcerpt(await renderSummary(writeup.data.summary)),
  }))),
})));
---
<Site path={archivePath(entry)} title={data.title} description={description}>
  <ArchiveMasthead title={data.title} parentHref="/" parentLabel="All competitions">
    <div class="archive-byline">
      <CompetitionDates start={data.start_date} end={data.end_date} />
      {data.ctftime_url && (
        <><BylineSeparator /><a href={data.ctftime_url} target="_blank" rel="noopener noreferrer" class="external-url">
          <ExternalUrl url={data.ctftime_url} />
        </a></>
      )}
    </div>
    {entry.body?.trim() && <div class="archive-intro"><Content /></div>}
    <CompetitionResults writeupCount={writeups.length} ranking={data.ranking} points={data.points} />
  </ArchiveMasthead>

  <section class="challenge-index">
    {groups.length > 0 ? (
      <>
        <h2>Writeups from {data.title}</h2>
        {groups.map(({ category, cards }) => (
          <div class="challenge-group">
            <h3 class="category-label">{category}</h3>
            <ul class="list challenge-list">
              {cards.map(({ writeup, summary }) => (
                <li>
                  <ArchiveRow href={archivePath(writeup)} class="challenge-row" label={writeup.data.title}>
                    <h4>{writeup.data.title}</h4>
                    <WriteupAttribution byline={attribution(writeup.data)} />
                    {summary && <p>{summary}</p>}
                  </ArchiveRow>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </>
    ) : (
      <>
        <h2>No writeups yet</h2>
        <p class="empty-state">We haven't published any writeups for this competition yet. Check back soon.</p>
      </>
    )}
  </section>

  <BackBar href="/">Back to all competitions</BackBar>
</Site>
