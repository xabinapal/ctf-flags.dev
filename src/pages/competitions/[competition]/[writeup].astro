---
import BackBar from "../../../components/BackBar.astro";
import ArchiveMasthead from "../../../components/ArchiveMasthead.astro";
import { render } from "astro:content";
import WriteupAttribution from "../../../components/WriteupAttribution.astro";
import WriteupCards from "../../../components/WriteupCards.astro";
import Site from "../../../layouts/Site.astro";
import { type Competition, type Writeup, archivePath, attribution, loadArchive, writeupCategory } from "../../../lib/archives";
import { htmlExcerpt, renderSummary, writeupIntro } from "../../../lib/markdown";

export async function getStaticPaths() {
  const { competitionsByKey, writeups } = await loadArchive();
  return writeups.map((entry) => {
    const [competition, writeup] = entry.id.split("/");
    return {
      params: { competition, writeup },
      props: { entry, parent: competitionsByKey.get(entry.data.competition) },
    };
  });
}

interface Props {
  entry: Writeup;
  parent?: Competition;
}

const { entry, parent } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const title = parent ? `${data.title} | ${parent.data.title}` : data.title;
const summary = await renderSummary(data.summary);
const { description: articleExcerpt, startsWithHeading } = writeupIntro(entry.rendered?.html ?? "");
const description = articleExcerpt || htmlExcerpt(summary) ||
  (parent ? `${data.title}, a challenge from ${parent.data.title}.` : `${data.title}, a capture-the-flag challenge.`);
const connections = (data.connections ?? []).map(({ url, description }) => ({ title: url, description }));
const attachments = (data.attachments ?? []).map(({ url, title, description }) => ({ href: url, title, description }));
const parentHref = parent ? archivePath(parent) : "/";
const category = writeupCategory(data);
const byline = attribution(data);
if (category) byline.unshift({ label: category });
---
<Site path={archivePath(entry)} title={title} description={description} socialType={entry.body?.trim() ? "article" : "website"}>
  <article class:list={["writeup", { "writeup-narrow-images": data.image_width === "narrow" }]}>
    <ArchiveMasthead title={data.title} parentHref={parentHref} parentLabel={parent?.data.title ?? "All competitions"}>
      {(byline.length > 0) && (
        <div class="archive-byline">
          <WriteupAttribution byline={byline} />
        </div>
      )}
      {summary && <div class="archive-intro" set:html={summary} />}
    </ArchiveMasthead>

    {(connections.length > 0 || attachments.length > 0) && (
      <div class="writeup-assets">
        <WriteupCards title="Connections" cards={connections} />
        <WriteupCards title="Attachments" cards={attachments} />
      </div>
    )}

    <div class="writeup-content">
      {entry.body?.trim() ? (
        <>
          {!startsWithHeading && <h2>Writeup</h2>}
          <Content />
        </>
      ) : (
        <>
          <h2>No writeup yet</h2>
          <p class="empty-state">We haven't published the writeup for this challenge yet. Check back soon.</p>
        </>
      )}
    </div>

    <BackBar href={parentHref}>Back to {parent?.data.title ?? "all competitions"}</BackBar>
  </article>
</Site>
