---
import type { InferGetStaticPropsType } from "astro";
import SectionMasthead from "../../components/SectionMasthead.astro";
import SectionTab from "../../components/SectionTab.astro";
import SectionTabs from "../../components/SectionTabs.astro";
import Base from "../../components/utilities/Base.astro";
import Jwt from "../../components/utilities/Jwt.astro";
import Morse from "../../components/utilities/Morse.astro";
import NumberUtility from "../../components/utilities/Number.astro";
import Rot from "../../components/utilities/Rot.astro";
import Timestamp from "../../components/utilities/Timestamp.astro";
import Url from "../../components/utilities/Url.astro";
import Xor from "../../components/utilities/Xor.astro";
import Site from "../../layouts/Site.astro";
import { utilityDetails, utilityMetadata, utilityPath } from "../../lib/utilities";

export function getStaticPaths() {
  const components = { number: NumberUtility, base: Base, url: Url, rot: Rot, xor: Xor, morse: Morse, timestamp: Timestamp, jwt: Jwt };
  const utilities = (Object.keys(utilityDetails) as (keyof typeof utilityDetails)[]).map((id) => ({
    id,
    label: utilityDetails[id].label,
    component: components[id],
  }));
  return [
    { params: { utility: undefined }, props: { utilities } },
    ...utilities.map(({ id }) => ({
      params: { utility: id },
      props: { utilities },
    })),
  ];
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { utilities } = Astro.props;
const { utility } = Astro.params;
const selected = utility ?? utilities[0].id;
const activeUtility = utilities.find(({ id }) => id === utility);
const { title, description } = utilityMetadata(activeUtility?.id);
---
<Site path={utilityPath(utility)} title={title} description={description}>
  <SectionMasthead flag="ut1l1t13s" subject="workbench" />

  <noscript><p>Enable JavaScript to use the utilities.</p></noscript>
  <section class="feature-section section-controls" data-utilities inert>
    <SectionTabs label="Utility">
      {utilities.map(({ id, label }) => (
        <SectionTab
          label={label}
          id={`utility-button-${id}`}
          data-utility={id}
          data-path={utilityPath(id)}
          aria-controls={`utility-${id}`}
          selected={id === selected}
        />
      ))}
    </SectionTabs>
    {utilities.map(({ id, label, component: Panel }) => (
      <div
        id={`utility-${id}`}
        class="utility-panel"
        role="region"
        data-utility-panel={id}
        aria-labelledby={`utility-button-${id}`}
        hidden={id !== selected}
      >
        <header class="utility-tool-heading">
          <h2>{label}</h2>
          <div class="utility-actions">
            <button type="button" class="utility-action utility-example" data-example>Try example</button>
            <button type="button" class="utility-action" data-clear disabled>Clear</button>
          </div>
        </header>
        <div class="utility-fields"><Panel /></div>
        <p class="utility-copy-status" role="status" data-copy-status></p>
      </div>
    ))}
  </section>
</Site>

<script>
  import "../../scripts/utilities/index.js";
</script>
