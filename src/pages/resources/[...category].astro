---
import ExternalUrl from "../../components/ExternalUrl.astro";
import { type CollectionEntry, getCollection } from "astro:content";
import SectionMasthead from "../../components/SectionMasthead.astro";
import SectionTab from "../../components/SectionTab.astro";
import SectionTabs from "../../components/SectionTabs.astro";
import Site from "../../layouts/Site.astro";
import { resourceMetadata, resourcePath } from "../../lib/resources";

export async function getStaticPaths() {
  const groups = (await getCollection("resources"))
    .sort((left, right) => left.id.localeCompare(right.id));
  return [
    { params: { category: undefined }, props: { groups } },
    ...groups.map(({ id }) => ({ params: { category: id }, props: { groups } })),
  ];
}

interface Props {
  groups: CollectionEntry<"resources">[];
}

const { groups } = Astro.props;
const { category } = Astro.params;
const { title, description } = resourceMetadata(category);
const options = [
  { id: "", label: "all" },
  ...groups.map(({ id }) => ({ id, label: id })),
];
---
<Site path={resourcePath(category)} title={title} description={description}>
  <SectionMasthead flag="r3s0urc3s" subject="toolkit" />

  <section class="feature-section resource-catalog" aria-label="Resource directory">
    <div class="section-controls" data-resource-controls inert>
      <SectionTabs label="Resource categories">
        {options.map((option) => (
          <SectionTab
            label={option.label}
            data-category={option.id}
            selected={option.id === (category ?? "")}
          />
        ))}
      </SectionTabs>
      <div class="resource-search">
        <label for="resource-search" class="field-label">Search resources</label>
        <input
          type="text"
          id="resource-search"
          class="search-input form-control"
          placeholder="By name or description"
          autocomplete="off"
        />
      </div>
    </div>

    <div id="resources-container">
      {groups.map(({ id, data: { resources } }) => (
        <div class="category" data-category={id} hidden={Boolean(category && id !== category)}>
          <h2 class="category-label">{id}</h2>
          <ul class="list resource-list">
            {resources.toSorted((left, right) =>
              left.name.localeCompare(right.name, "en", { sensitivity: "base" }),
            ).map((resource) => (
              <li class="list-item" data-name={resource.name.toLowerCase()} data-description={resource.description.toLowerCase()}>
                <a href={resource.url} target="_blank" rel="noopener noreferrer" class="resource-row" aria-label={resource.name}>
                  <h3 class="resource-title">{resource.name}</h3>
                  <p class="resource-description">{resource.description}</p>
                  <span class="external-url resource-url"><ExternalUrl url={resource.url} /></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div role="status">
      <p id="no-results" class="empty-state" hidden>No resources found matching your search criteria.</p>
    </div>
  </section>

</Site>

<script>
  import "../../scripts/resource-filters";
</script>
