---
import Base from "../components/utilities/Base.astro";
import Jwt from "../components/utilities/Jwt.astro";
import Morse from "../components/utilities/Morse.astro";
import Number from "../components/utilities/Number.astro";
import Rot from "../components/utilities/Rot.astro";
import Timestamp from "../components/utilities/Timestamp.astro";
import Url from "../components/utilities/Url.astro";
import Xor from "../components/utilities/Xor.astro";
import Site from "../layouts/Site.astro";

const description = "Interactive utilities and helpers for CTF players. Access quick tools and essential helpers for puzzles and challenges, cybersecurity competitions, and infosec problem-solving.";
const tools = [
  { id: "number", label: "Number", component: Number },
  { id: "base", label: "Base", component: Base },
  { id: "url", label: "URL", component: Url },
  { id: "rot", label: "ROT", component: Rot },
  { id: "xor", label: "XOR", component: Xor },
  { id: "morse", label: "Morse", component: Morse },
  { id: "timestamp", label: "Timestamp", component: Timestamp },
  { id: "jwt", label: "JWT", component: Jwt },
];
---
<Site path="/utilities/" title="Utilities" description={description}>
  <section class="hero">
    <h1>flag&#123;ut1l1t13s&#125;</h1>
    <p class="summary">{description}</p>
  </section>

  <noscript><p>Enable JavaScript to use the utilities.</p></noscript>
  <section class="section" data-utilities inert>
    <div class="selector" role="group" aria-label="Utility">
      {tools.map(({ id, label }, index) => (
        <button
          type="button"
          id={`utility-button-${id}`}
          class:list={["chip-rounded", { active: index === 0 }]}
          data-utility={id}
          aria-controls={`utility-${id}`}
          aria-pressed={index === 0 ? "true" : "false"}
        >{label}</button>
      ))}
    </div>
    <div id="utility-container">
      {tools.map(({ id, component: Panel }, index) => (
        <div
          id={`utility-${id}`}
          role="region"
          data-utility-panel={id}
          aria-labelledby={`utility-button-${id}`}
          hidden={index !== 0}
        ><Panel /></div>
      ))}
    </div>
  </section>
</Site>

<script>
  import "../scripts/utilities/index.js";
</script>
