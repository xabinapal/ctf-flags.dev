{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!.astro",
      "!!dist",
      "!!node_modules",
      "!!test-results",
      "!!public/assets",
      "!**/*.html",
      "!**/*.md",
      "!**/*.astro"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noRedundantUseStrict": "off"
      }
    }
  }
}
